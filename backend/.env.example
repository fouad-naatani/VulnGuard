```env
# ==========================================
# VulnGuard Environment Configuration
# ==========================================
# Copy this file to .env and replace the
# placeholder values with your local values.
#
# NEVER commit the real .env file to GitHub.
# ==========================================


# ------------------------------------------
# Application
# ------------------------------------------

ENVIRONMENT=development
DEBUG=false

API_PREFIX=/api


# ------------------------------------------
# Database - PostgreSQL
# ------------------------------------------

DATABASE_URL=postgresql+asyncpg://vmp:CHANGE_ME@localhost:5432/vmp


# ------------------------------------------
# Security / JWT
# ------------------------------------------

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080


# ------------------------------------------
# CORS
# ------------------------------------------

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500


# ------------------------------------------
# Initial Administrator
# ------------------------------------------

FIRST_ADMIN_EMAIL=admin@vulnguard.local
FIRST_ADMIN_PASSWORD=<-- Your password --> 


# ------------------------------------------
# Trivy
# ------------------------------------------

TRIVY_BINARY=trivy
TRIVY_TIMEOUT_SECONDS=900


# ------------------------------------------
# Wazuh API
# ------------------------------------------
# Leave empty if Wazuh is not configured.

WAZUH_API_URL=
WAZUH_API_USER=<-- Wazuh API username -->
WAZUH_API_PASSWORD=<-- Wazuh API password -->

WAZUH_VERIFY_SSL=false


# ------------------------------------------
# Wazuh Indexer / OpenSearch
# ------------------------------------------

WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=<-- Wazuh indexer username -->
WAZUH_INDEXER_PASSWORD=<-- Wazuh indexer password -->


# ------------------------------------------
# Nessus
# ------------------------------------------
# Leave empty if Nessus is not configured.

NESSUS_URL=

NESSUS_ACCESS_KEY= <-- Nessus access key -->
NESSUS_SECRET_KEY= <-- Nessus secret key -->

NESSUS_VERIFY_SSL=false


# ------------------------------------------
# Optional application settings
# ------------------------------------------

LOG_LEVEL=INFO
```
